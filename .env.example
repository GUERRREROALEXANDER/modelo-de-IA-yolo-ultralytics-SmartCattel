# Copy to .env (git-ignored) and fill in. Never commit real values.
# Camera id reported to the backend.
CAMERA_ID=camera-01
# Full stream URL. If set, it wins over the CAMERA_* parts below.
CAMERA_RTSP_URL=
# Camera IP on the local network (Imou Life > device > device info, or the router client list).
CAMERA_HOST=
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=admin
# Safety code printed on the camera label, or the RTSP/ONVIF password set in Imou Life.
CAMERA_PASSWORD=
# subtype=1 is the low-resolution sub stream (good for YOLO); subtype=0 is the main stream.
CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=1
# Backend base URL, e.g. http://localhost:8000 or https://<your-service>.onrender.com
SMARTCATTLE_BACKEND_URL=
# Must match the backend AI_API_KEY.
SMARTCATTLE_API_KEY=
# Safe zone left,top,right,bottom as fractions of the frame.
SMARTCATTLE_ZONE=0.1,0.1,0.9,0.9
# live.py video server (optional). Origins: frontend URLs allowed to read /status.
SMARTCATTLE_LIVE_PORT=8090
SMARTCATTLE_LIVE_ORIGINS=
